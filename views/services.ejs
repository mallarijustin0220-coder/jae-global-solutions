      <!-- 2. ADMINISTRATIVE SUPPORT -->
      <div class="service-card-3d" data-aos="fade-up" data-aos-delay="200">
        <div class="card-glow-bg"></div>
        <div class="card-icon-box">
          <span class="card-emoji">📂</span>
        </div>
        <h3 class="card-category-title">Administrative Support</h3>
        <p class="card-category-desc">Streamline executive workflows and core back-office data operations for maximum operational velocity.</p>
        <ul class="role-list">
          <li onclick="openRoleModal('Virtual Assistants', 'Administrative Support', 'Provide high-level executive assistance including complex calendar coordination, inbox management, and travel logistics.', ['Executive Calendar & Inbox', 'Travel Logistics & Booking', 'Operational Coordination'])">
            <span>Virtual assistants</span>
            <span class="arrow-icon">→</span>
          </li>
          <li onclick="openRoleModal('Data Entry Specialists', 'Administrative Support', 'Maintain meticulously accurate records and streamline digital filing systems with absolute speed and reliability.', ['High-Volume Data Processing', 'Database Cleaning & Audit', 'Spreadsheet Management'])">
            <span>Data entry specialists</span>
            <span class="arrow-icon">→</span>
          </li>
        </ul>
      </div>

      <!-- 3. IT & SOFTWARE -->
      <div class="service-card-3d" data-aos="fade-up" data-aos-delay="300">
        <div class="card-glow-bg"></div>
        <div class="card-icon-box">
          <span class="card-emoji">💻</span>
        </div>
        <h3 class="card-category-title">IT & Software</h3>
        <p class="card-category-desc">Deploy full-stack engineering expertise and proactive IT infrastructure support tailored to your tech stack.</p>
        <ul class="role-list">
