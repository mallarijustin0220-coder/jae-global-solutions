<!-- CINEMATIC FOOTER STYLES -->
<style>
  .cinematic-footer {
    position: relative;
    background: #020611;
    color: #94A3B8;
    padding: 40px 0 20px;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
    overflow: hidden;
  }

  .footer-glow-bg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #38BDF8, #0A8B88, transparent);
    box-shadow: 0 0 20px #38BDF8;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 30px;
    margin-bottom: 30px;
  }

  .footer-logo {
    color: #FFF;
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .footer-logo span {
    color: #0A8B88;
    text-shadow: 0 0 10px rgba(10, 139, 136, 0.5);
  }

  .brand-desc {
    font-size: 0.82rem;
    line-height: 1.5;
    color: #94A3B8;
    margin-bottom: 16px;
  }

  .footer-col h4 {
    color: #FFF;
    font-size: 0.92rem;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: 0.5px;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.82rem;
  }

  .footer-col ul li a {
    color: #94A3B8;
    text-decoration: none;
    transition: all 0.25s ease;
    display: inline-block;
  }

  .footer-col ul li a:hover {
    color: #38BDF8;
    transform: translateX(4px);
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
  }

  .office-loc {
    font-size: 0.82rem;
    margin-bottom: 6px;
  }

  .teal-glow { color: #0A8B88; }
  .gold-glow { color: #D49B27; }

  /* SOCIAL LINKS */
  .social-links-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-label {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .social-icons {
    display: flex;
    gap: 8px;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #CBD5E1;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .social-icon svg {
    width: 15px;
    height: 15px;
  }

  .social-icon:hover {
    background: #0A8B88;
    color: #FFF;
    border-color: #38BDF8;
    transform: translateY(-3px) scale(1.08) rotate(3deg);
    box-shadow: 0 6px 15px rgba(10, 139, 136, 0.5);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 18px;
    text-align: center;
    font-size: 0.78rem;
    color: #64748B;
  }

  /* RESPONSIVE LAYOUT BREAKPOINTS */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 500px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>

<!-- SCRIPTS & ANIMATION FAILSAFE -->
<script src="https://unpkg.com/swup@4"></script>
<script src="https://unpkg.com/@swup/head-plugin@2"></script>
<script src="https://unpkg.com/aos@next/dist/aos.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof AOS !== 'undefined') {
      AOS.init({ once: true, duration: 600 });
    }
  });

  setTimeout(function() {
    document.querySelectorAll('.cinematic-footer [data-aos]').forEach(function(el) {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  }, 1000);
</script>