<header class="site-header">
  <div class="nav-container">
    
    <!-- BRAND LOGO WITH TEXT FALLBACK -->
    <a href="/" class="nav-logo">
      <img src="/images/logo.png" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" alt="JAE Global Solutions" />
      <span class="logo-fallback-text" style="display:none;">JAE GLOBAL</span>
    </a>

    <!-- DESKTOP NAV MENU / MOBILE SLIDE-OUT DRAWER -->
    <nav class="nav-menu" id="nav-menu">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/services" class="nav-link">Services</a></li>
        <li><a href="/about" class="nav-link">About Us</a></li>
        <li><a href="/reviews" class="nav-link">Reviews</a></li>
      </ul>
      <a href="/contact" class="btn-book-call mobile-drawer-cta">Book Call →</a>
    </nav>

    <!-- RIGHT CONTROLS -->
    <div class="nav-actions">
      <a href="/contact" class="btn-book-call desktop-cta">Book Call →</a>

      <!-- HAMBURGER BUTTON -->
      <button class="nav-toggle" id="nav-toggle-btn" type="button" aria-label="Toggle Navigation">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

  </div>
</header>

<style id="header-scoped-styles">
  /* BOX-SIZING & BASE SCOPING */
  .site-header, .site-header * {
    box-sizing: border-box !important;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
  }

  .site-header {
    position: sticky !important;
    top: 0 !important;
    width: 100% !important;
    background: rgba(3, 10, 22, 0.95) !important;
    backdrop-filter: blur(12px) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    z-index: 9999 !important;
    padding: 14px 0 !important;
  }

  .site-header .nav-container {
    max-width: 1200px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
  }

  /* LOGO AREA */
  .site-header .nav-logo {
    display: flex !important;
    align-items: center !important;
    text-decoration: none !important;
  }

  .site-header .nav-logo img {
    height: 38px !important;
    width: auto !important;
    max-width: 180px !important;
    object-fit: contain !important;
    display: block !important;
  }

  .site-header .logo-fallback-text {
    color: #ffffff !important;
    font-weight: 800 !important;
    font-size: 1.2rem !important;
    letter-spacing: 1px !important;
  }

  /* DESKTOP NAV */
  .site-header .nav-menu {
    display: flex !important;
    align-items: center !important;
  }

  .site-header .nav-list {
    display: flex !important;
    flex-direction: row !important;
    list-style: none !important;
    gap: 32px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .site-header .nav-link {
    color: #cbd5e1 !important;
    text-decoration: none !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    transition: color 0.2s ease !important;
  }

  .site-header .nav-link:hover {
    color: #38bdf8 !important;
  }

  .site-header .mobile-drawer-cta {
    display: none !important;
  }

  /* RIGHT CTA & TOGGLE */
  .site-header .nav-actions {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
  }

  .site-header .btn-book-call {
    background: linear-gradient(135deg, #0a8b88, #38bdf8) !important;
    color: #ffffff !important;
    padding: 9px 20px !important;
    border-radius: 20px !important;
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    display: inline-block !important;
    border: none !important;
  }

  .site-header .nav-toggle {
    display: none !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    padding: 4px !important;
    flex-direction: column !important;
    gap: 5px !important;
  }

  .site-header .bar {
    width: 24px !important;
    height: 2px !important;
    background-color: #ffffff !important;
    border-radius: 2px !important;
    transition: all 0.3s ease !important;
  }

  /* MOBILE RESPONSIVE RULES (< 768px) */
  @media screen and (max-width: 768px) {
    .site-header .nav-toggle {
      display: flex !important;
    }

    .site-header .desktop-cta {
      display: none !important;
    }

    .site-header .nav-menu {
      position: fixed !important;
      top: 0 !important;
      right: -100% !important;
      width: 78% !important;
      max-width: 300px !important;
      height: 100vh !important;
      background: #020611 !important;
      border-left: 1px solid rgba(255, 255, 255, 0.1) !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      padding: 90px 24px 40px !important;
      gap: 24px !important;
      transition: right 0.3s ease-in-out !important;
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.8) !important;
    }

    .site-header .nav-menu.is-active {
      right: 0 !important;
    }

    .site-header .nav-list {
      flex-direction: column !important;
      width: 100% !important;
      gap: 18px !important;
    }

    .site-header .nav-link {
      font-size: 1.1rem !important;
      display: block !important;
    }

    .site-header .mobile-drawer-cta {
      display: block !important;
      width: 100% !important;
      text-align: center !important;
      margin-top: 12px !important;
    }

    /* HAMBURGER TRANSFORMATION */
    .site-header .nav-toggle.is-active .bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg) !important;
    }
    .site-header .nav-toggle.is-active .bar:nth-child(2) {
      opacity: 0 !important;
    }
    .site-header .nav-toggle.is-active .bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg) !important;
    }
  }
</style>

<script>
  // GLOBAL DELEGATED SCRIPT TO SUPPORT CLIENT-SIDE PAGE TRANSITIONS
  (function() {
    if (window.__hdr_init) return;
    window.__hdr_init = true;

    document.addEventListener('click', function (e) {
      const toggleBtn = e.target.closest('#nav-toggle-btn');
      const navMenu = document.getElementById('nav-menu');
      const activeBtn = document.getElementById('nav-toggle-btn');

      if (toggleBtn && navMenu) {
        toggleBtn.classList.toggle('is-active');
        navMenu.classList.toggle('is-active');
        return;
      }

      if (e.target.closest('.nav-link') && navMenu && activeBtn) {
        navMenu.classList.remove('is-active');
        activeBtn.classList.remove('is-active');
        return;
      }

      if (navMenu && navMenu.classList.contains('is-active')) {
        if (!e.target.closest('.site-header')) {
          navMenu.classList.remove('is-active');
          if (activeBtn) activeBtn.classList.remove('is-active');
        }
      }
    });
  })();
</script>