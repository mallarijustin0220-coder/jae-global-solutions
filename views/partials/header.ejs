<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JAE Global Solutions | People First. Excellence Always.</title>

  <!-- External CDNs -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">

  <!-- Main External Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Global Reset & Base Styles */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background: #030A16;
      color: #F8FAFC;
    }

    /* 4D Multi-Layer Animated Navbar Container */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      padding: 14px 0;
      background: linear-gradient(135deg, rgba(3, 10, 22, 0.88), rgba(10, 25, 47, 0.75), rgba(3, 10, 22, 0.92));
      background-size: 300% 300%;
      animation: gradientShift 12s ease infinite;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid rgba(56, 189, 248, 0.18);
      box-shadow: 
        0 15px 35px -10px rgba(0, 0, 0, 0.8),
        inset 0 1px 1px rgba(255, 255, 255, 0.15),
        0 4px 20px rgba(56, 189, 248, 0.08);
      overflow: hidden;
    }

    /* 4D Background Shifting Keyframes */
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* 4D Floating Light Orbs */
    .site-header::before,
    .site-header::after {
      content: '';
      position: absolute;
      width: 250px;
      height: 250px;
      border-radius: 50%;
      filter: blur(60px);
      pointer-events: none;
      z-index: -1;
      opacity: 0.35;
      animation: floatOrbs 10s ease-in-out infinite alternate;
    }

    .site-header::before {
      background: radial-gradient(circle, rgba(56, 189, 248, 0.8), transparent 70%);
      top: -100px;
      left: -50px;
    }

    .site-header::after {
      background: radial-gradient(circle, rgba(212, 155, 39, 0.6), transparent 70%);
      bottom: -100px;
      right: -50px;
      animation-delay: -5s;
    }

    @keyframes floatOrbs {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(60px, 20px) scale(1.2); }
    }

    .header-container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 2;
    }

    /* Brand & Logo Styling (Fixed Motion) */
    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      position: relative;
    }

    .nav-logo-img {
      height: 44px;
      width: auto;
      object-fit: contain;
      border-radius: 6px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
      transition: filter 0.3s ease;
    }

    .navbar-brand:hover .nav-logo-img {
      filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.6));
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .brand-title {
      font-size: 1.25rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: 0.5px;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
    }

    .teal-text { color: #0A8B88; }
    .cyan-text { color: #38BDF8; }

    .brand-tagline {
      font-size: 0.58rem;
      color: #D49B27;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-top: 3px;
    }

    /* Desktop Navigation Links (No Movement on Hover) */
    .nav-menu {
      display: flex;
      align-items: center;
      gap: 20px;
      list-style: none;
      background: rgba(255, 255, 255, 0.03);
      padding: 8px 20px;
      border-radius: 30px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.4), 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .nav-link {
      color: #94A3B8;
      text-decoration: none;
      font-size: 0.90rem;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 20px;
      transition: color 0.3s ease, background 0.3s ease, text-shadow 0.3s ease, box-shadow 0.3s ease;
      display: inline-block;
      position: relative;
    }

    /* Fixed hover state: No translateY motion */
    .nav-link:hover, .nav-link.active {
      color: #38BDF8;
      background: rgba(56, 189, 248, 0.1);
      text-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
      box-shadow: inset 0 0 8px rgba(56, 189, 248, 0.2);
    }

    /* Header CTA Button (Fixed Motion) */
    .btn-header-cta {
      background: linear-gradient(135deg, #D49B27 0%, #B8821B 100%);
      color: #FFFFFF;
      padding: 10px 22px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 4px 15px rgba(212, 155, 39, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
      transition: box-shadow 0.3s ease, filter 0.3s ease;
      display: inline-block;
      position: relative;
      overflow: hidden;
    }

    .btn-header-cta:hover {
      box-shadow: 0 0 22px rgba(212, 155, 39, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.6);
      filter: brightness(1.1);
    }

    /* Mobile Hamburger Icon */
    .mobile-nav-toggle {
      display: none;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 8px;
      z-index: 1001;
    }

    .hamburger-bar {
      display: block;
      width: 24px;
      height: 2px;
      margin: 5px 0;
      background: #F8FAFC;
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    /* Mobile Responsive Layout */
    @media (max-width: 991px) {
      .mobile-nav-toggle {
        display: block;
      }

      .mobile-nav-toggle.active .hamburger-bar:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
        background: #38BDF8;
      }

      .mobile-nav-toggle.active .hamburger-bar:nth-child(2) {
        opacity: 0;
      }

      .mobile-nav-toggle.active .hamburger-bar:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
        background: #38BDF8;
      }

      .nav-menu {
        position: fixed;
        top: 80px;
        left: 5%;
        width: 90%;
        background: rgba(10, 25, 47, 0.95);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 20px;
        padding: 24px;
        flex-direction: column;
        gap: 12px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(56, 189, 248, 0.25);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
      }

      .nav-menu.active {
        opacity: 1;
        visibility: visible;
      }

      .nav-menu li {
        width: 100%;
        text-align: center;
      }

      .nav-link {
        font-size: 1.05rem;
        padding: 10px 0;
        display: block;
        width: 100%;
      }
    }
  </style>
</head>
<body>

<header class="site-header">
  <div class="header-container">

    <!-- BRAND LOGO & TITLE (Acts as Home Link) -->
    <a href="/" class="navbar-brand">
      <img src="/images/logo.jpeg" alt="JAE Global Solutions Logo" class="nav-logo-img" />
      <div class="brand-text">
        <span class="brand-title">
          <strong class="teal-text">JAE</strong> <span class="cyan-text">GLOBAL</span>
        </span>
        <small class="brand-tagline">PEOPLE FIRST. EXCELLENCE ALWAYS.</small>
      </div>
    </a>

    <!-- MOBILE HAMBURGER TOGGLE -->
    <button class="mobile-nav-toggle" aria-label="Toggle Navigation" onclick="toggleMobileNav()">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <!-- NAVIGATION LINKS (Home Link Removed) -->
    <nav>
      <ul class="nav-menu" id="navMenu">
        <li><a href="/about" class="nav-link">About Us</a></li>
        <li><a href="/services" class="nav-link">Services</a></li>
        <li><a href="/why-jae" class="nav-link">Why JAE</a></li>
        <li><a href="/culture" class="nav-link">Culture</a></li>
        <li><a href="/how-it-works" class="nav-link">How It Works</a></li>
        <li><a href="/careers" class="nav-link">Careers</a></li>
        <li><a href="/reviews" class="nav-link">Reviews</a></li>
      </ul>
    </nav>

    <!-- SINGLE CALL TO ACTION BUTTON -->
    <div class="header-actions">
      <a href="https://calendly.com/admin-jaeglobalsolutions" target="_blank" rel="noopener noreferrer" class="btn-header-cta">Book Call →</a>
    </div>

  </div>
</header>

<script>
  function toggleMobileNav() {
    const navMenu = document.getElementById('navMenu');
    const toggleBtn = document.querySelector('.mobile-nav-toggle');
    navMenu.classList.toggle('active');
    toggleBtn.classList.toggle('active');
  }
</script>

</body>
</html>