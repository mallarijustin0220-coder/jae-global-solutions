<header class="site-header">
  <div class="nav-container">
    
    <!-- BRAND LOGO -->
    <a href="/" class="nav-logo">
      <img src="/images/logo.png" alt="JAE Global Solutions Logo" />
    </a>

    <!-- ORIGINAL MOBILE-ORDER RIGHT CONTROLS WRAPPER (Now enforced rigid spacing) -->
    <div class="nav-mobile-right">
      <a href="/contact" class="btn-book-call header-cta">Book Call →</a>

      <!-- HAMBURGER / CLOSE TOGGLE (Always visible in this layout structure) -->
      <button class="nav-toggle" id="nav-toggle-btn" aria-label="Toggle navigation">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>

    <!-- MAIN NAVIGATION LINKS (Retained on the right in this layout structure) -->
    <nav class="nav-menu" id="nav-menu">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/services" class="nav-link">Services</a></li>
        <li><a href="/about" class="nav-link">About Us</a></li>
        <li><a href="/reviews" class="nav-link">Reviews</a></li>
      </ul>
      <!-- Mobile CTA container (Hidden when menu is active in this structure) -->
      <div class="menu-cta-container">
        <a href="/contact" class="btn-book-call menu-cta">Book Call →</a>
      </div>
    </nav>

  </div>
</header>

<style>
  /* Base Desktop Styles (Enforced non-responsive flex) */
  .site-header {
    position: sticky;
    top: 0;
    width: 100%;
    background: rgba(3, 10, 22, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 1000;
    padding: 10px 0;
    box-sizing: border-box;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
  }

  .nav-logo img {
    height: 36px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Right-Floating Control Group (Retained mobile positioning structure) */
  .nav-mobile-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Base Navigation Styles */
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 20px;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: #CBD5E1;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #38BDF8;
  }

  /* CTA Button Base Styles */
  .btn-book-call {
    background: linear-gradient(135deg, #0A8B88, #38BDF8);
    color: #FFF;
    padding: 7px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .btn-book-call:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.4);
  }

  .menu-cta-container {
    display: none;
  }

  /* Toggle Button Styles (Always display in this structure) */
  .nav-toggle {
    display: flex;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    flex-direction: column;
    gap: 4px;
    z-index: 1001;
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background-color: #FFF;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* ENFORCED NON-RESPONSIVE MEDIA QUERY (<768px) */
  @media (max-width: 768px) {
    /* Keep the toggle button working, but enforce standard sizing and spacing */
    .nav-toggle {
      display: flex;
    }

    /* Prevent text and elements from collapsing into each other */
    .nav-link, .btn-book-call, .nav-logo img {
      white-space: nowrap;
    }

    .site-header .header-cta {
      padding: 6px 12px;
      font-size: 0.72rem;
    }

    /* Handle Active Mobile Menu State based on this structure */
    .nav-menu.is-active {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      right: 0;
      width: 75%;
      max-width: 280px;
      height: 100vh;
      background: #020611;
      border-left: 1px solid rgba(255, 255, 255, 0.1);
      padding: 70px 20px 30px;
      gap: 20px;
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.8);
      z-index: 1000;
    }

    .nav-menu.is-active .nav-list {
      flex-direction: column;
      width: 100%;
      gap: 12px;
    }

    .nav-menu.is-active .nav-link {
      font-size: 1rem;
      padding: 6px 0;
      display: block;
    }

    .nav-menu.is-active .menu-cta-container {
      display: block;
      width: 100%;
      margin-top: 10px;
    }

    .nav-menu.is-active .menu-cta {
      display: block;
      text-align: center;
      width: 100%;
      padding: 10px 0;
      box-sizing: border-box;
    }

    /* HAMBURGER TO X ANIMATION (Works on smaller screen widths with rigid containment) */
    .nav-toggle.is-active .hamburger-bar:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    .nav-toggle.is-active .hamburger-bar:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle.is-active .hamburger-bar:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>

<script>
  function initHeaderMenuToggle() {
    const toggleBtn = document.getElementById('nav-toggle-btn');
    const navMenu = document.getElementById('nav-menu');

    if (toggleBtn && navMenu) {
      toggleBtn.onclick = () => {
        toggleBtn.classList.toggle('is-active');
        navMenu.classList.toggle('is-active');
      };

      // Ensure menu closes when clicking a navigation link
      document.querySelectorAll('.nav-link').forEach(link => {
        link.onclick = () => {
          toggleBtn.classList.remove('is-active');
          navMenu.classList.remove('is-active');
        };
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initHeaderMenuToggle);
  // Ensure function works across client-side page transitions
  if (typeof swup !== 'undefined') {
    swup.hooks.on('page:view', initHeaderMenuToggle);
  }
</script>