<%- include('partials/header') %>

<style>
  .contact-hero {
    position: relative;
    padding: 80px 24px;
    background: radial-gradient(circle at 50% 20%, rgba(56, 189, 248, 0.15) 0%, rgba(3, 10, 22, 1) 70%);
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 1;
  }
  .glow-1 {
    width: 300px;
    height: 300px;
    background: rgba(10, 139, 136, 0.3);
    top: 10%;
    left: 10%;
  }
  .glow-2 {
    width: 350px;
    height: 350px;
    background: rgba(212, 155, 39, 0.2);
    bottom: 10%;
    right: 10%;
  }

  .contact-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    position: relative;
    z-index: 2;
    perspective: 1200px;
  }

  .glass-card {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.1);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.5s ease;
    transform-style: preserve-3d;
  }

  .glass-card:hover {
    box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.7), 0 0 30px rgba(56, 189, 248, 0.25);
  }

  .contact-info-panel h1 {
    font-size: 2.8rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    text-shadow: 0 4px 12px rgba(0,0,0,0.6);
  }

  .contact-info-panel p {
    color: #94A3B8;
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 30px;
  }

  .info-tile {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    margin-bottom: 16px;
    transition: transform 0.3s ease;
  }

  .info-tile:hover {
    transform: translateZ(20px) translateX(6px);
    background: rgba(255, 255, 255, 0.06);
  }

  .info-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #0A8B88, #38BDF8);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    color: #38BDF8;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .form-control {
    width: 100%;
    padding: 14px 18px;
    background: rgba(3, 10, 22, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    color: #F8FAFC;
    font-size: 0.95rem;
    font-family: inherit;
    transition: all 0.3s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: #38BDF8;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
    background: rgba(3, 10, 22, 0.9);
  }

  textarea.form-control {
    resize: vertical;
    min-height: 120px;
  }

  /* Multi-Select Interactive Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }

  .checkbox-pill {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(3, 10, 22, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 10px 14px;
    cursor: pointer;
    transition: all 0.25s ease;
    user-select: none;
  }

  .checkbox-pill input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .checkbox-pill span {
    font-size: 0.85rem;
    color: #94A3B8;
    font-weight: 600;
  }

  .checkbox-pill:has(input:checked) {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38BDF8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.25);
  }

  .checkbox-pill:has(input:checked) span {
    color: #38BDF8;
  }

  .btn-submit-3d {
    width: 100%;
    padding: 16px;
    background: linear-gradient(135deg, #D49B27 0%, #B8821B 100%);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(212, 155, 39, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .btn-submit-3d:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 30px rgba(212, 155, 39, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .alert-success {
    background: rgba(10, 139, 136, 0.2);
    border: 1px solid #0A8B88;
    color: #38BDF8;
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 24px;
    text-align: center;
    font-weight: 600;
  }

  @media (max-width: 991px) {
    .contact-container {
      grid-template-columns: 1fr;
    }
    .glass-card {
      padding: 28px;
    }
    .contact-info-panel h1 {
      font-size: 2.2rem;
    }
  }
</style>

<section class="contact-hero">
  <div class="glow-orb glow-1"></div>
  <div class="glow-orb glow-2"></div>

  <div class="contact-container">
    
    <!-- LEFT PANEL -->
    <div class="glass-card contact-info-panel">
      <h1>Get in <span class="cyan-text">Touch</span></h1>
      <p>Ready to scale your business with elite offshore talent? Fill out the form or reach out directly to start building your team.</p>

      <div class="info-tile">
        <div class="info-icon">✉️</div>
        <div>
          <small style="color: #94A3B8; font-weight: 700; text-transform: uppercase;">Direct Email</small>
          <div style="font-weight: 700; color: #F8FAFC;">admin@jaeglobalsolutions.com</div>
        </div>
      </div>

      <div class="info-tile">
        <div class="info-icon">📍</div>
        <div>
          <small style="color: #94A3B8; font-weight: 700; text-transform: uppercase;">Headquarters</small>
          <div style="font-weight: 700; color: #F8FAFC;">Australia & Philippines Offshore Services</div>
        </div>
      </div>

      <div class="info-tile">
        <div class="info-icon">⚡</div>
        <div>
          <small style="color: #94A3B8; font-weight: 700; text-transform: uppercase;">Response Time</small>
          <div style="font-weight: 700; color: #F8FAFC;">Within 24 Hours</div>
        </div>
      </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="glass-card">
      <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div class="alert-success">
          <%= successMsg %>
        </div>
      <% } %>

      <form action="/contact" method="POST">
        <div class="form-group">
          <label for="fullName">Full Name *</label>
          <input type="text" id="fullName" name="fullName" class="form-control" placeholder="e.g. John Doe" required>
        </div>

        <div class="form-group">
          <label for="companyName">Company Name</label>
          <input type="text" id="companyName" name="companyName" class="form-control" placeholder="e.g. Acme Corp">
        </div>

        <div class="form-group">
          <label for="businessEmail">Business Email *</label>
          <input type="email" id="businessEmail" name="businessEmail" class="form-control" placeholder="name@company.com" required>
        </div>

        <!-- MULTI-SELECT SERVICES SECTION -->
        <div class="form-group">
          <label>Services Required (Select all that apply)</label>
          <div class="services-grid">
            <label class="checkbox-pill">
              <input type="checkbox" name="serviceRequired" value="Offshore Team Building">
              <span>Offshore Team Building</span>
            </label>
            <label class="checkbox-pill">
              <input type="checkbox" name="serviceRequired" value="Technical & IT Staffing">
              <span>Technical & IT Staffing</span>
            </label>
            <label class="checkbox-pill">
              <input type="checkbox" name="serviceRequired" value="Virtual Assistance">
              <span>Virtual Assistance</span>
            </label>
            <label class="checkbox-pill">
              <input type="checkbox" name="serviceRequired" value="Customer Support">
              <span>Customer Support</span>
            </label>
            <label class="checkbox-pill">
              <input type="checkbox" name="serviceRequired" value="General Inquiry">
              <span>General Inquiry</span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label for="description">Message / Staffing Needs *</label>
          <textarea id="description" name="description" class="form-control" placeholder="Tell us about the roles or support you need..." required></textarea>
        </div>

        <button type="submit" class="btn-submit-3d">Send Message →</button>
      </form>
    </div>

  </div>
</section>
<%- include('partials/chat-widget') %>
<%- include('partials/footer') %>