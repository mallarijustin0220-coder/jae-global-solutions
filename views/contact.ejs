<%- include('partials/header') %>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .contact-hero {
    position: relative;
    padding: 60px 20px;
    background: radial-gradient(circle at 50% 20%, rgba(56, 189, 248, 0.15) 0%, rgba(3, 10, 22, 1) 70%);
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: hidden;
    width: 100%;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 1;
  }
  .glow-1 {
    width: 300px;
    height: 300px;
    background: rgba(10, 139, 136, 0.3);
    top: 10%;
    left: 10%;
  }
  .glow-2 {
    width: 350px;
    height: 350px;
    background: rgba(212, 155, 39, 0.2);
    bottom: 10%;
    right: 10%;
  }

  .contact-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 30px;
    position: relative;
    z-index: 2;
  }

  .glass-card {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 32px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    width: 100%;
  }

  .contact-info-panel h1 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    text-shadow: 0 4px 12px rgba(0,0,0,0.6);
  }

  .contact-info-panel p {
    color: #94A3B8;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 30px;
  }

.info-tile {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  margin-bottom: 16px;
}

.info-tile > div:last-child {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}

  .info-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, #0A8B88, #38BDF8);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
  }

  .form-group {
    margin-bottom: 20px;
    width: 100%;
  }

  .form-group label.main-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #38BDF8;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .form-control {
    width: 100%;
    padding: 12px 16px;
    background: rgba(3, 10, 22, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    color: #F8FAFC;
    font-size: 0.95rem;
    font-family: inherit;
    transition: all 0.3s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: #38BDF8;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
    background: rgba(3, 10, 22, 0.9);
  }

  textarea.form-control {
    resize: vertical;
    min-height: 100px;
  }

  /* =========================================
     ACCORDION MULTI-SELECT ROLES
     ========================================= */
  .category-group {
    margin-bottom: 12px;
    padding: 12px;
    background: rgba(3, 10, 22, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    transition: background 0.3s ease;
  }

  .category-toggle {
    width: 100%;
    background: none;
    border: none;
    padding: 4px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 800;
    color: #D49B27;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: inherit;
    text-align: left;
  }

  .category-toggle:focus {
    outline: none;
  }

  .toggle-icon {
    font-size: 1.4rem;
    font-weight: 300;
    color: #38BDF8;
    transition: transform 0.3s ease;
    line-height: 1;
  }

  /* Rotate icon when active */
  .category-toggle.active .toggle-icon {
    transform: rotate(45deg);
  }

  .roles-grid {
    display: none; /* Hidden initially */
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 8px;
    margin-top: 16px;
    animation: slideDown 0.3s ease forwards;
  }

  /* Show grid when active class is applied via JS */
  .roles-grid.active {
    display: grid;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .checkbox-pill {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(3, 10, 22, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    width: 100%;
  }

  .checkbox-pill input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .checkbox-pill span {
    font-size: 0.82rem;
    color: #94A3B8;
    font-weight: 600;
    text-transform: none;
  }

  .checkbox-pill:has(input:checked) {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38BDF8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.25);
  }

  .checkbox-pill:has(input:checked) span {
    color: #38BDF8;
  }

  .btn-submit-3d {
    width: 100%;
    padding: 16px;
    background: linear-gradient(135deg, #D49B27 0%, #B8821B 100%);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(212, 155, 39, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .btn-submit-3d:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(212, 155, 39, 0.6);
  }

  .alert-success {
    background: rgba(10, 139, 136, 0.2);
    border: 1px solid #0A8B88;
    color: #38BDF8;
    padding: 14px;
    border-radius: 12px;
    margin-bottom: 20px;
    text-align: center;
    font-weight: 600;
  }

  /* RESPONSIVE BREAKPOINTS */
  @media (max-width: 991px) {
    .contact-container {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 576px) {
    .contact-hero {
      padding: 40px 12px;
    }
    .glass-card {
      padding: 20px;
      border-radius: 16px;
    }
    .contact-info-panel h1 {
      font-size: 2rem;
    }
    .roles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="contact-hero">
  <div class="glow-orb glow-1"></div>
  <div class="glow-orb glow-2"></div>

  <div class="contact-container">
    
    <!-- LEFT PANEL -->
    <div class="glass-card contact-info-panel">
      <h1>Get in <span class="cyan-text" style="color: #38BDF8;">Touch</span></h1>
      <p>Ready to scale your business with elite offshore talent? Fill out the form or reach out directly to start building your team.</p>

      <div class="info-tile">
        <div class="info-icon">✉️</div>
        <div>
          <small style="color: #94A3B8; font-weight: 700; text-transform: uppercase; font-size: 0.75rem;">Direct Email</small>
          <div style="font-weight: 700; color: #F8FAFC; font-size: 0.95rem;">admin@jaeglobalsolutions.com</div>
        </div>
      </div>

      <div class="info-tile">
        <div class="info-icon">📍</div>
        <div>
          <small style="color: #94A3B8; font-weight: 700; text-transform: uppercase; font-size: 0.75rem;">Headquarters</small>
          <div style="font-weight: 700; color: #F8FAFC; font-size: 0.95rem;">Australia & Philippines Offshore Services</div>
        </div>
      </div>

      <div class="info-tile">
        <div class="info-icon">⚡</div>
        <div>
          <small style="color: #94A3B8; font-weight: 700; text-transform: uppercase; font-size: 0.75rem;">Response Time</small>
          <div style="font-weight: 700; color: #F8FAFC; font-size: 0.95rem;">Within 24 Hours</div>
        </div>
      </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="glass-card">
      <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div class="alert-success">
          <%= successMsg %>
        </div>
      <% } %>

      <form action="/contact" method="POST">
        <div class="form-group">
          <label class="main-label" for="fullName">Full Name *</label>
          <input type="text" id="fullName" name="fullName" class="form-control" placeholder="e.g. John Doe" required>
        </div>

        <div class="form-group">
          <label class="main-label" for="companyName">Company Name</label>
          <input type="text" id="companyName" name="companyName" class="form-control" placeholder="e.g. Acme Corp">
        </div>

        <div class="form-group">
          <label class="main-label" for="businessEmail">Business Email *</label>
          <input type="email" id="businessEmail" name="businessEmail" class="form-control" placeholder="name@company.com" required>
        </div>

        <!-- CATEGORIZED MULTI-SELECT ACCORDION -->
        <div class="form-group">
          <label class="main-label">Services & Roles Required (Select all that apply)</label>
          
          <!-- Customer Support & Sales -->
          <div class="category-group">
            <button type="button" class="category-toggle" onclick="toggleRoles(this)">
              <span>🎧 Customer Support & Sales</span>
              <span class="toggle-icon">+</span>
            </button>
            <div class="roles-grid">
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Customer Service Representative">
                <span>Customer Service Representatives</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Lead Generator">
                <span>Lead Generators</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Business Development Executive">
                <span>Business Development Executives</span>
              </label>
            </div>
          </div>

          <!-- Administrative Support -->
          <div class="category-group">
            <button type="button" class="category-toggle" onclick="toggleRoles(this)">
              <span>📁 Administrative Support</span>
              <span class="toggle-icon">+</span>
            </button>
            <div class="roles-grid">
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Virtual Assistant">
                <span>Virtual Assistants</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Data Entry Specialist">
                <span>Data Entry Specialists</span>
              </label>
            </div>
          </div>

          <!-- IT & Software -->
          <div class="category-group">
            <button type="button" class="category-toggle" onclick="toggleRoles(this)">
              <span>💻 IT & Software</span>
              <span class="toggle-icon">+</span>
            </button>
            <div class="roles-grid">
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Software Developer">
                <span>Software Developers</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="IT Support Specialist">
                <span>IT Support Specialists</span>
              </label>
            </div>
          </div>

          <!-- Creative Services -->
          <div class="category-group">
            <button type="button" class="category-toggle" onclick="toggleRoles(this)">
              <span>🎨 Creative Services</span>
              <span class="toggle-icon">+</span>
            </button>
            <div class="roles-grid">
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Graphic Designer">
                <span>Graphic Designers</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Content Writer">
                <span>Content Writers</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Social Media Management">
                <span>Social Media Management</span>
              </label>
            </div>
          </div>

          <!-- Finance -->
          <div class="category-group">
            <button type="button" class="category-toggle" onclick="toggleRoles(this)">
              <span>📊 Finance</span>
              <span class="toggle-icon">+</span>
            </button>
            <div class="roles-grid">
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Bookkeeper">
                <span>Bookkeepers</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Accountant">
                <span>Accountants</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Accounts Receivable Specialist">
                <span>Accounts Receivable Specialists</span>
              </label>
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Accounts Payable Specialist">
                <span>Accounts Payable Specialists</span>
              </label>
            </div>
          </div>

          <!-- Other Services / Bespoke Roles -->
          <div class="category-group">
            <button type="button" class="category-toggle" onclick="toggleRoles(this)">
              <span>🚀 Other Services / Bespoke Roles</span>
              <span class="toggle-icon">+</span>
            </button>
            <div class="roles-grid">
              <label class="checkbox-pill">
                <input type="checkbox" name="serviceRequired" value="Bespoke / Custom Role">
                <span>Custom / Specialized Role</span>
              </label>
            </div>
          </div>

        </div>

        <div class="form-group">
          <label class="main-label" for="description">Message / Staffing Needs *</label>
          <textarea id="description" name="description" class="form-control" placeholder="Tell us about your specific staffing needs..." required></textarea>
        </div>

        <button type="submit" class="btn-submit-3d">Send Message →</button>
      </form>
    </div>

  </div>
</section>

<!-- Simple Script to Handle Accordion Toggles -->
<script>
  function toggleRoles(button) {
    // Toggles the "active" class on the clicked button (rotates the + to x)
    button.classList.toggle('active');
    
    // Finds the associated grid directly below it and toggles its visibility
    const grid = button.nextElementSibling;
    grid.classList.toggle('active');
  }
</script>

<%- include('partials/footer') %>