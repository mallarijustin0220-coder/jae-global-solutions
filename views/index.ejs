  /* ==========================================================================
     RENDER ROLES
     ========================================================================== */

  function renderRoles(
    categoryKey
  ) {

    const category =
      SERVICE_LIBRARY[
        categoryKey
      ];


    if (!category) {
      return;
    }


    selectedTitle.textContent =
      category.title;


    selectedDescription.textContent =
      category.description;


    selectedLink.href =
      category.link;


    rolesContainer.innerHTML =
      '';


    category.roles.forEach(
      role => {

        const roleElement =
          document.createElement(
            'div'
          );


        roleElement.className =
          'role-chip';


        roleElement.innerHTML = `

          <i class="fa-solid ${role.icon}"></i>

          <span>
            ${role.title}
          </span>

        `;


        rolesContainer.appendChild(
          roleElement
        );

      }
    );


    /* Update card role count */

    cards.forEach(
      card => {

        const key =
          card.dataset.serviceCategory;


        const count =
          SERVICE_LIBRARY[key]?.roles?.length ||
          0;


        const countElement =
          card.querySelector(
            '.library-role-count'
          );


        if (countElement) {

          countElement.innerHTML = `

            <i class="fa-solid fa-users"></i>

            ${count} Available Roles

          `;

        }

      }
    );

  }


  /* ==========================================================================
     ACTIVE CARD
     ========================================================================== */

  function setActiveCard(
    index,
    scrollCard = true
  ) {

    if (!cards.length) {
      return;
    }


    const safeIndex =
      Math.max(
        0,
        Math.min(
          index,
          cards.length - 1
        )
      );


    cards.forEach(
      (card, cardIndex) => {

        card.classList.toggle(
          'is-active',
          cardIndex === safeIndex
        );

      }
    );


    dots.forEach(
      (dot, dotIndex) => {

        dot.classList.toggle(
          'is-active',
          dotIndex === safeIndex
        );

      }
    );


    const activeCard =
      cards[safeIndex];


    if (
      scrollCard &&
      activeCard
    ) {

      activeCard.scrollIntoView({

        behavior:
          'smooth',

        block:
          'nearest',

        inline:
          'center'

      });

    }


    if (activeCard) {

      renderRoles(
        activeCard.dataset.serviceCategory
      );

    }

  }


  /* ==========================================================================
     GET ACTIVE INDEX
     ========================================================================== */

  function getActiveIndex() {

    const activeIndex =
      cards.findIndex(
        card =>
          card.classList.contains(
            'is-active'
          )
      );


    return activeIndex >= 0
      ? activeIndex
      : 0;

  }


  /* ==========================================================================
     CLICK CATEGORY
     ========================================================================== */

  cards.forEach(
    (card, index) => {

      card.addEventListener(
        'click',
        () => {

          setActiveCard(
            index
          );

        }
      );


      card.addEventListener(
        'keydown',
        event => {

          if (
            event.key === 'Enter' ||
            event.key === ' '
          ) {

            event.preventDefault();


            setActiveCard(
              index
            );

          }

        }
      );

    }
  );


  /* ==========================================================================
     PREVIOUS
     ========================================================================== */

  prevButton?.addEventListener(
    'click',
    () => {

      const index =
        getActiveIndex();


      setActiveCard(
        index - 1
      );

    }
  );


  /* ==========================================================================
     NEXT
     ========================================================================== */

  nextButton?.addEventListener(
    'click',
    () => {

      const index =
        getActiveIndex();


      setActiveCard(
        index + 1
      );

    }
  );


  /* ==========================================================================
     DOTS
     ========================================================================== */

  dots.forEach(
    (dot, index) => {

      dot.addEventListener(
        'click',
        () => {

          setActiveCard(
            index
          );

        }
      );

    }
  );


  /* ==========================================================================
     DRAG TO SCROLL
     ========================================================================== */

  let isDragging = false;

  let startX = 0;

  let startScrollLeft = 0;


  track.addEventListener(
    'pointerdown',
    event => {

      if (
        event.pointerType === 'mouse'
      ) {

        isDragging = true;


        startX =
          event.clientX;


        startScrollLeft =
          track.scrollLeft;


        track.setPointerCapture(
          event.pointerId
        );

      }

    }
  );


  track.addEventListener(
    'pointermove',
    event => {

      if (!isDragging) {
        return;
      }


      const distance =
        event.clientX -
        startX;


      track.scrollLeft =
        startScrollLeft -
        distance;

    }
  );


  function stopDragging() {

    isDragging =
      false;

  }


  track.addEventListener(
    'pointerup',
    stopDragging
  );


  track.addEventListener(
    'pointercancel',
    stopDragging
  );


  track.addEventListener(
    'pointerleave',
    stopDragging
  );


  /* ==========================================================================
     UPDATE ACTIVE CARD AFTER SWIPE
     ========================================================================== */

  let scrollTimer = null;


  track.addEventListener(
    'scroll',
    () => {

      clearTimeout(
        scrollTimer
      );


      scrollTimer =
        setTimeout(
          () => {

            const trackRect =
              track.getBoundingClientRect();


            const centerX =
              trackRect.left +
              trackRect.width / 2;


            let closestIndex = 0;

            let closestDistance =
              Infinity;


            cards.forEach(
              (card, index) => {

                const rect =
                  card.getBoundingClientRect();


                const cardCenter =
                  rect.left +
                  rect.width / 2;


                const distance =
                  Math.abs(
                    centerX -
                    cardCenter
                  );


                if (
                  distance <
                  closestDistance
                ) {

                  closestDistance =
                    distance;


                  closestIndex =
                    index;

                }

              }
            );


            setActiveCard(
              closestIndex,
              false
            );

          },
          100
        );

    },
    {
      passive:
        true
    }
  );


  /* ==========================================================================
     KEYBOARD SUPPORT
     ========================================================================== */

  track.addEventListener(
    'keydown',
    event => {

      if (
        event.key === 'ArrowLeft'
      ) {

        event.preventDefault();


        setActiveCard(
          getActiveIndex() - 1
        );

      }


      if (
        event.key === 'ArrowRight'
      ) {

        event.preventDefault();


        setActiveCard(
          getActiveIndex() + 1
        );

      }

    }
  );


  /* ==========================================================================
     INITIALIZE
     ========================================================================== */

  setActiveCard(
    0,
    false
  );

});

