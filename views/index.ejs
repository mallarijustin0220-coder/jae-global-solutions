<!-- ==========================================================================
   SERVICE LIBRARY
   Swipe / drag categories and reveal roles inside each category
   ========================================================================== -->
<section class="service-library-section" id="services-section">
  <div class="ambient-glow service-library-glow"></div>

  <div class="container">
    <div class="section-header-centered" data-aos="fade-up">
      <span class="section-badge">OUR TALENT LIBRARY</span>

      <h2 class="section-title">
        Explore Our
        <span class="gradient-text-au">Offshore Capabilities</span>
      </h2>

      <p class="section-subtitle">
        Browse our specialist service categories, then open each category
        to discover the roles available for your offshore team.
      </p>
    </div>

    <!-- CATEGORY LIBRARY -->
    <div class="service-library-shell" data-aos="fade-up">

      <button
        class="library-nav library-nav-left"
        type="button"
        aria-label="Previous service category"
        id="service-library-prev">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div
        class="service-library-track"
        id="service-library-track"
        tabindex="0"
        aria-label="Service categories">

        <!-- CATEGORY 1 -->
        <article
          class="service-library-card is-active"
          data-service-category="virtual-assistants"
          tabindex="0">

          <div class="library-card-topline">
            <span class="library-card-number">01</span>

            <div class="library-card-icon cyan">
              <i class="fa-solid fa-headset"></i>
            </div>
          </div>

          <div class="library-card-content">
            <span class="library-card-label">CATEGORY</span>

            <h3>
              Virtual Assistants
              & Executive Admin
            </h3>

            <p>
              Dedicated offshore professionals who support your
              leadership, administration, scheduling, communication,
              customer coordination, and day-to-day operations.
            </p>
          </div>

          <div class="library-card-footer">
            <span class="library-role-count">
              <i class="fa-solid fa-users"></i>
              Explore roles
            </span>

            <span class="library-open-icon">
              <i class="fa-solid fa-arrow-right"></i>
            </span>
          </div>
        </article>

        <!-- CATEGORY 2 -->
        <article
          class="service-library-card"
          data-service-category="data-entry"
          tabindex="0">

          <div class="library-card-topline">
            <span class="library-card-number">02</span>

            <div class="library-card-icon gold">
              <i class="fa-solid fa-database"></i>
            </div>
          </div>

          <div class="library-card-content">
            <span class="library-card-label">CATEGORY</span>

            <h3>
              Data Entry
              & Operational Support
            </h3>

            <p>
              Structured offshore support for data processing, CRM
              maintenance, document handling, reporting, reconciliation,
              and operational workflows.
            </p>
          </div>

          <div class="library-card-footer">
            <span class="library-role-count">
              <i class="fa-solid fa-users"></i>
              Explore roles
            </span>

            <span class="library-open-icon">
              <i class="fa-solid fa-arrow-right"></i>
            </span>
          </div>
        </article>

        <!-- CATEGORY 3 -->
        <article
          class="service-library-card"
          data-service-category="it-staffing"
          tabindex="0">

          <div class="library-card-topline">
            <span class="library-card-number">03</span>

            <div class="library-card-icon cyan">
              <i class="fa-solid fa-laptop-code"></i>
            </div>
          </div>

          <div class="library-card-content">
            <span class="library-card-label">CATEGORY</span>

            <h3>
              Technical & IT
              Offshore Staffing
            </h3>

            <p>
              Technical specialists covering development, quality
              assurance, cloud infrastructure, IT support, engineering,
              and technical operations.
            </p>
          </div>

          <div class="library-card-footer">
            <span class="library-role-count">
              <i class="fa-solid fa-users"></i>
              Explore roles
            </span>

            <span class="library-open-icon">
              <i class="fa-solid fa-arrow-right"></i>
            </span>
          </div>
        </article>

        <!-- CATEGORY 4 -->
        <article
          class="service-library-card"
          data-service-category="dedicated-teams"
          tabindex="0">

          <div class="library-card-topline">
            <span class="library-card-number">04</span>

            <div class="library-card-icon gold">
              <i class="fa-solid fa-users-gear"></i>
            </div>
          </div>

          <div class="library-card-content">
            <span class="library-card-label">CATEGORY</span>

            <h3>
              Dedicated Team
              Building
            </h3>

            <p>
              Build entire offshore departments with tailored
              recruitment, team leadership, HR support, technology,
              compliance, payroll, and operational management.
            </p>
          </div>

          <div class="library-card-footer">
            <span class="library-role-count">
              <i class="fa-solid fa-users"></i>
              Explore roles
            </span>

            <span class="library-open-icon">
              <i class="fa-solid fa-arrow-right"></i>
            </span>
          </div>
        </article>

      </div>

      <button
        class="library-nav library-nav-right"
        type="button"
        aria-label="Next service category"
        id="service-library-next">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>

    <!-- SWIPE INDICATOR -->
    <div class="library-pagination" id="library-pagination">
      <button class="library-dot is-active" type="button" aria-label="Category 1"></button>
      <button class="library-dot" type="button" aria-label="Category 2"></button>
      <button class="library-dot" type="button" aria-label="Category 3"></button>
      <button class="library-dot" type="button" aria-label="Category 4"></button>
    </div>

    <div class="library-swipe-hint">
      <i class="fa-solid fa-hand-pointer"></i>
      <span>Swipe, drag, or use the arrows to explore categories</span>
    </div>

    <!-- SELECTED CATEGORY / ROLES -->
    <div
      class="selected-service-panel is-visible"
      id="selected-service-panel"
      data-aos="fade-up">

      <div class="selected-service-heading">
        <div>
          <span class="selected-service-eyebrow">AVAILABLE ROLES</span>
          <h3 id="selected-service-title">
            Virtual Assistants & Executive Admin
          </h3>
        </div>

        <a
          href="/services#virtual-assistants"
          class="selected-service-link"
          id="selected-service-link">
          View Full Service
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </a>
      </div>

      <p
        class="selected-service-description"
        id="selected-service-description">
        Discover the specialist roles available inside this service category.
      </p>

      <div
        class="roles-library"
        id="roles-library">
        
        <!--
          IMPORTANT:
          These are intentionally examples tied only to the categories visible
          in the uploaded index page.

          Replace these with the exact roles from your /services page.
        -->

        <div class="role-chip">
          <i class="fa-solid fa-user-tie"></i>
          <span>Executive Assistant</span>
        </div>

        <div class="role-chip">
          <i class="fa-solid fa-calendar-check"></i>
          <span>Virtual Assistant</span>
        </div>

        <div class="role-chip">
          <i class="fa-solid fa-clipboard-user"></i>
          <span>Administrative Support</span>
        </div>

        <div class="role-chip">
          <i class="fa-solid fa-headset"></i>
          <span>Client Support</span>
        </div>

      </div>

      <div class="selected-service-bottom">
        <a href="/services" class="btn-3d-primary">
          <span>View All Services & Roles →</span>
        </a>
      </div>
    </div>

    <!-- CTA -->
    <div class="services-global-cta" data-aos="fade-up">
      <div class="cta-inner-card">
        <span class="cta-mini-label">BUILD YOUR TEAM</span>

        <h3>
          Need a custom talent arrangement?
        </h3>

        <p>
          We can combine specialist roles across multiple categories
          to create a dedicated offshore team around your exact
          operational requirements.
        </p>

        <a href="/services" class="btn-3d-primary">
          <span>Explore All Services →</span>
        </a>
      </div>
    </div>

  </div>
</section>