<style>
  html {
    scroll-behavior: smooth;
  }

  .hero-cinematic-wrapper {
    position: relative;
    background: radial-gradient(circle at 50% 20%, #0B192E 0%, #020611 100%);
    color: #F8FAFC;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 120px 24px 60px;
    perspective: 1000px;
  }

  #hero-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero-container-centered {
    max-width: 1080px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 10;
    transition: transform 0.1s ease-out;
    transform-style: preserve-3d;
  }

  .ambient-glow { position: absolute; border-radius: 50%; filter: blur(140px); pointer-events: none; }
  .glow-cyan { width: 650px; height: 650px; background: rgba(56, 189, 248, 0.15); top: -100px; left: 50%; transform: translateX(-50%); }
  .glow-gold { width: 500px; height: 500px; background: rgba(212, 155, 39, 0.12); bottom: 20px; right: 10%; }
  .glow-cyan-lower { width: 600px; height: 600px; background: rgba(56, 189, 248, 0.08); top: 20%; left: -10%; }

  .hero-text-content { 
    max-width: 900px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
  }

  .hero-badge {
    display: inline-flex; 
    align-items: center; 
