  const rolesContainer =
    document.getElementById(
      'roles-library'
    );


  /* ==========================================================================
     SERVICE DATA

     These category names come from the uploaded index page.

     Replace ONLY the roles below with the exact /services roles once you have
     the complete services list.
     ========================================================================== */

