<!-- ==========================================================================
   THREE.JS
   ========================================================================== -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>


<!-- ==========================================================================
   MAIN JAVASCRIPT
   ========================================================================== -->

<script>

document.addEventListener('DOMContentLoaded', () => {

  /* ==========================================================================
     1. PARTICLE CANVAS
     ========================================================================== */

  const canvas =
    document.getElementById('hero-canvas');

  const heroContainer =
    document.getElementById('hero-container');

  const target =
    document.getElementById('parallax-target');


  if (canvas && heroContainer) {

    const ctx =
      canvas.getContext('2d');

    let width =
      canvas.width =
        heroContainer.offsetWidth;

    let height =
      canvas.height =
        heroContainer.offsetHeight;


    const particles = [];


    function createParticles() {

      particles.length = 0;

      const particleCount =
        Math.max(
          18,
          Math.floor(width / 22)
        );


      for (
        let i = 0;
        i < particleCount;
        i++
      ) {

        particles.push({

          x:
            Math.random() * width,

          y:
            Math.random() * height,

          radius:
            Math.random() * 2 + 1,

          vx:
            (Math.random() - 0.5) * 0.8,

          vy:
            (Math.random() - 0.5) * 0.8,

          alpha:
            Math.random() * 0.5 + 0.2

        });

      }

    }


    createParticles();


    window.addEventListener(
      'resize',
      () => {

        width =
          canvas.width =
            heroContainer.offsetWidth;

        height =
          canvas.height =
            heroContainer.offsetHeight;

        createParticles();

      }
    );


    /* Desktop parallax only */

    heroContainer.addEventListener(
      'mousemove',
      event => {

        if (
          window.matchMedia(
            '(pointer: coarse)'
          ).matches
        ) {
          return;
        }


        const rect =
          heroContainer.getBoundingClientRect();


        const mouseX =
          event.clientX -
          rect.left -
          width / 2;


        const mouseY =
          event.clientY -
          rect.top -
          height / 2;


        const rotateX =
          (mouseY / height) * -8;


        const rotateY =
          (mouseX / width) * 8;


        if (target) {

          target.style.transform =
            `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;

        }

      }
    );


    heroContainer.addEventListener(
      'mouseleave',
      () => {

        if (target) {

          target.style.transform =
            'rotateX(0deg) rotateY(0deg)';

        }

      }
    );


    function renderCanvas() {

      ctx.clearRect(
        0,
        0,
        width,
        height
      );


      for (
        let i = 0;
        i < particles.length;
        i++
      ) {

        const p =
          particles[i];


        p.x += p.vx;

        p.y += p.vy;


        if (
          p.x < 0 ||
          p.x > width
        ) {
          p.vx *= -1;
        }


        if (
          p.y < 0 ||
          p.y > height
        ) {
          p.vy *= -1;
        }


        ctx.beginPath();

        ctx.arc(
          p.x,
          p.y,
          p.radius,
          0,
          Math.PI * 2
        );

        ctx.fillStyle =
          `rgba(56,189,248,${p.alpha})`;

        ctx.fill();


        for (
          let j = i + 1;
          j < particles.length;
          j++
        ) {

          const p2 =
            particles[j];


          const dx =
            p.x - p2.x;

          const dy =
            p.y - p2.y;


          const dist =
            Math.sqrt(
              dx * dx +
              dy * dy
            );


          if (dist < 120) {

            ctx.beginPath();

            ctx.moveTo(
              p.x,
              p.y
            );

            ctx.lineTo(
              p2.x,
              p2.y
            );

            ctx.strokeStyle =
              `rgba(56,189,248,${0.18 * (1 - dist / 120)})`;

            ctx.lineWidth = 0.6;

            ctx.stroke();

          }

        }

      }


      requestAnimationFrame(
        renderCanvas
      );

    }


    renderCanvas();

  }


  /* ==========================================================================
     2. THREE.JS GLOBE
     ========================================================================== */

  (function initCentered3DGlobe() {

    const container =
      document.getElementById(
        'globe3d-container'
      );


    if (!container) return;


    let width =
      container.clientWidth || 600;


    let height =
      container.clientHeight || 460;


    const scene =
      new THREE.Scene();


    const camera =
      new THREE.PerspectiveCamera(
        45,
        width / height,
        0.1,
        1000
      );


    camera.position.set(
      0,
      0,
      210
    );


    camera.lookAt(
      0,
      0,
      0
    );


    const renderer =
      new THREE.WebGLRenderer({
        alpha: true,
        antialias: true
      });


    renderer.setSize(
      width,
      height
    );


    renderer.setPixelRatio(
      Math.min(
        window.devicePixelRatio || 1,
        2
      )
    );


    renderer.toneMapping =
      THREE.ACESFilmicToneMapping;


    renderer.toneMappingExposure =
      1.25;


    container.appendChild(
      renderer.domElement
    );


    const controls =
      new THREE.OrbitControls(
        camera,
        renderer.domElement
      );


    controls.enableZoom = false;

    controls.enablePan = false;

    controls.enableDamping = true;

    controls.dampingFactor = 0.05;

    controls.autoRotate = true;

    controls.autoRotateSpeed = 1.2;

    controls.rotateSpeed = 0.8;

    controls.target.set(
      0,
      0,
      0
    );


    const ambientLight =
      new THREE.AmbientLight(
        0xffffff,
        1.0
      );


    scene.add(
      ambientLight
    );


    const sunLight =
      new THREE.DirectionalLight(
        0xffffff,
        2.4
      );


    sunLight.position.set(
      150,
      120,
      180
    );


    scene.add(
      sunLight
    );


    const cyanRimLight =
      new THREE.DirectionalLight(
        0x38bdf8,
        1.5
      );


    cyanRimLight.position.set(
      -180,
      -100,
      -100
    );


    scene.add(
      cyanRimLight
    );


    const goldRimLight =
      new THREE.DirectionalLight(
        0xd49b27,
        1.2
      );


    goldRimLight.position.set(
      180,
      -120,
      -100
    );


    scene.add(
      goldRimLight
    );


    const textureLoader =
      new THREE.TextureLoader();


    const earthMap =
      textureLoader.load(
        'https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg'
      );


    const earthBump =
      textureLoader.load(
        'https://unpkg.com/three-globe/example/img/earth-topology.png'
      );


    const radius = 58;


    const globeGroup =
      new THREE.Group();


    scene.add(
      globeGroup
    );


    /* EARTH */

    const sphereGeo =
      new THREE.SphereGeometry(
        radius,
        64,
        64
      );


    const sphereMat =
      new THREE.MeshStandardMaterial({

        map:
          earthMap,

        bumpMap:
          earthBump,

        bumpScale:
          1.4,

        roughness:
          0.7,

        metalness:
          0.15

      });


    const earthMesh =
      new THREE.Mesh(
        sphereGeo,
        sphereMat
      );


    globeGroup.add(
      earthMesh
    );


    /* ATMOSPHERE */

    const atmosGeo =
      new THREE.SphereGeometry(
        radius + 2,
        64,
        64
      );


    const atmosMat =
      new THREE.MeshBasicMaterial({

        color:
          0x38bdf8,

        transparent:
          true,

        opacity:
          0.15,

        side:
          THREE.BackSide

      });


    const atmosMesh =
      new THREE.Mesh(
        atmosGeo,
        atmosMat
      );


    globeGroup.add(
      atmosMesh
    );


    /* GRID */

    const gridGeo =
      new THREE.SphereGeometry(
        radius + 0.5,
        36,
        36
      );


    const gridMat =
      new THREE.MeshBasicMaterial({

        color:
          0x38bdf8,

        wireframe:
          true,

        transparent:
          true,

        opacity:
          0.12

      });


    const gridMesh =
      new THREE.Mesh(
        gridGeo,
        gridMat
      );


    globeGroup.add(
      gridMesh
    );


    /* LAT / LNG */

    function latLngToVector3(
      lat,
      lng,
      r
    ) {

      const phi =
        (90 - lat) *
        (Math.PI / 180);


      const theta =
        (lng + 180) *
        (Math.PI / 180);


      return new THREE.Vector3(

        -(
          r *
          Math.sin(phi) *
          Math.cos(theta)
        ),

        r *
        Math.cos(phi),

        r *
        Math.sin(phi) *
        Math.sin(theta)

      );

    }


    const locations = {

      philippines: {
        lat: 12.8797,
        lng: 121.7740,
        color: 0xd49b27
      },

      australia: {
        lat: -25.2744,
        lng: 133.7751,
        color: 0x38bdf8
      },

      uk: {
        lat: 55.3781,
        lng: -3.4360,
        color: 0xfacc15
      }

    };


    const rings = [];


    Object.values(
      locations
    ).forEach(
      loc => {

        const pos =
          latLngToVector3(
            loc.lat,
            loc.lng,
            radius + 0.8
          );


        const nodeGeo =
          new THREE.SphereGeometry(
            2.4,
            16,
            16
          );


        const nodeMat =
          new THREE.MeshBasicMaterial({
            color: loc.color
          });


        const nodeMesh =
          new THREE.Mesh(
            nodeGeo,
            nodeMat
          );


        nodeMesh.position.copy(
          pos
        );


        globeGroup.add(
          nodeMesh
        );


        const ringGeo =
          new THREE.RingGeometry(
            2.5,
            4.5,
            32
          );


        const ringMat =
          new THREE.MeshBasicMaterial({

            color:
              loc.color,

            side:
              THREE.DoubleSide,

            transparent:
              true,

            opacity:
              0.85

          });


        const ringMesh =
          new THREE.Mesh(
            ringGeo,
            ringMat
          );


        ringMesh.position.copy(
          pos
        );


        ringMesh.lookAt(
          0,
          0,
          0
        );


        globeGroup.add(
          ringMesh
        );


        rings.push(
          ringMesh
        );

      }
    );


    /* CONNECTION ARCS */

    function createArc(
      posA,
      posB,
      colorHex
    ) {

      const distance =
        posA.distanceTo(
          posB
        );


      const mid =
        posA.clone()
          .add(posB)
          .multiplyScalar(0.5);


      const midLength =
        mid.length();


      mid.normalize();


      mid.multiplyScalar(
        midLength +
        distance * 0.28
      );


      const curve =
        new THREE.QuadraticBezierCurve3(
          posA,
          mid,
          posB
        );


      const points =
        curve.getPoints(60);


      const geometry =
        new THREE.BufferGeometry()
          .setFromPoints(points);


      const material =
        new THREE.LineDashedMaterial({

          color:
            colorHex,

          dashSize:
            2.5,

          gapSize:
            1.5,

          transparent:
            true,

          opacity:
            0.95

        });


      const line =
        new THREE.Line(
          geometry,
          material
        );


      line.computeLineDistances();


      return line;

    }


    const posPH =
      latLngToVector3(
        locations.philippines.lat,
        locations.philippines.lng,
        radius + 0.8
      );


    const posAU =
      latLngToVector3(
        locations.australia.lat,
        locations.australia.lng,
        radius + 0.8
      );


    const posUK =
      latLngToVector3(
        locations.uk.lat,
        locations.uk.lng,
        radius + 0.8
      );


    globeGroup.add(
      createArc(
        posAU,
        posPH,
        0x38bdf8
      )
    );


    globeGroup.add(
      createArc(
        posUK,
        posPH,
        0xfacc15
      )
    );


    globeGroup.rotation.y =
      -2.2;


    globeGroup.rotation.x =
      0.2;


    let scaleDirection = 1;


    function animateGlobe() {

      requestAnimationFrame(
        animateGlobe
      );


      controls.update();


      rings.forEach(
        ring => {

          ring.scale.x +=
            0.003 *
            scaleDirection;

          ring.scale.y +=
            0.003 *
            scaleDirection;


          if (
            ring.scale.x > 1.25
          ) {
            scaleDirection = -1;
          }


          if (
            ring.scale.x < 0.95
          ) {
            scaleDirection = 1;
          }

        }
      );


      renderer.render(
        scene,
        camera
      );

    }


    animateGlobe();


    function resizeGlobe() {

      width =
        container.clientWidth ||
        600;


      height =
        container.clientHeight ||
        460;


      camera.aspect =
        width / height;


      camera.updateProjectionMatrix();


      renderer.setSize(
        width,
        height
      );

    }


    window.addEventListener(
      'resize',
      resizeGlobe
    );

  })();


  /* ==========================================================================
     3. SERVICE LIBRARY
     ========================================================================== */

  const track =
    document.getElementById(
      'service-library-track'
    );


  if (!track) return;


  const cards =
    Array.from(
      track.querySelectorAll(
        '.service-library-card'
      )
    );


  const dots =
    Array.from(
